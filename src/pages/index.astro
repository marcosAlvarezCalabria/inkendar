---
import '../styles/global.css';

const features = [
  ['inbox', 'Solicitudes en orden', 'Las consultas de la web llegan al panel y pueden convertirse en trabajos organizados sin copiar la información a mano.', 'Instagram y WhatsApp se añadirán después de validar sus integraciones oficiales.'],
  ['file', 'Una Ficha de Trabajo completa', 'Brief, referencias, zona del cuerpo, tamaño, artista, citas y estado de la señal permanecen juntos durante todo el trabajo.', ''],
  ['mobile', 'Captura rápida en el estudio', 'Si el cliente está delante, el equipo puede registrar la idea y las referencias desde móvil o tablet. El cliente no necesita instalar nada.', ''],
  ['today', 'La vista “Hoy” de cada artista', 'Cada artista ve sus citas del día con la información y las imágenes necesarias para preparar el trabajo.', ''],
];

const plans = [
  { id: 'artist', label: 'Artista', audience: 'Tatuadores independientes', cta: 'Consultar Plan Artista', items: ['1 usuario / artista', 'Solicitudes web integradas', 'Fichas, citas y control de señas', 'Captura presencial en móvil o tablet', 'Vista diaria del artista'] },
  { id: 'studio', label: 'Estudio', audience: 'Estudios multiartista', cta: 'Consultar Plan Estudio', recommended: true, items: ['Todo lo del Plan Artista', 'Espacios y permisos para varios artistas', 'Asignación de trabajos y citas', 'Flujo compartido y control de señas', 'Canales conectados tras su validación'] },
];
---

<!--
THESIS: Inkendar convierte mensajes dispersos en una ficha de trabajo; rechaza el hero SaaS abstracto y el cliché gótico.
OWN-WORLD: Negro tinta, papel frío y naranja incandescente; logo mecánico, fichas compactas, sellos y líneas de orden de trabajo.
STORY: El visitante sigue una consulta desde el canal del cliente hasta la respuesta del estudio, compara su plan y solicita una plaza piloto.
FIRST VIEWPORT: Oferta y CTA a la izquierda; a la derecha, varios canales se ensamblan en una ficha real.
FORM: Persuade; dirección “ficha de estudio” fijada por el brief, con demostración operativa en el hero.
-->
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content="Inkendar reúne solicitudes, referencias, citas y señas en una única ficha de trabajo para estudios de tatuaje." />
  <meta name="theme-color" content="#0B0B0F" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>Inkendar — Todo tu estudio en una ficha</title>
</head>
<body>
  <a class="skip-link" href="#main" data-i18n="skip.content">Saltar al contenido</a>
  <header class="site-header">
    <a class="brand brand--logo" href="#top" aria-label="Inkendar, inicio" data-i18n-aria="header.home"><img src="/inkendar-logo.png" width="1774" height="887" alt="Inkendar" /></a>
    <nav aria-label="Navegación principal" data-i18n-aria="nav.label"><a href="#recorrido" data-i18n="nav.change">Recorrido</a><a href="#funciones" data-i18n="nav.features">Funciones</a><a href="#precios" data-i18n="nav.pricing">Planes</a></nav>
    <div class="header-actions">
      <div class="language-switch" role="group" aria-label="Idioma / Language">
        <button type="button" data-language="es" aria-pressed="true">ES</button><button type="button" data-language="en" aria-pressed="false">EN</button>
        <span class="sr-only" data-language-status role="status" aria-live="polite"></span>
      </div>
      <button class="button button--small button--accent header-pilot" type="button" data-open-pilot data-plan="studio"><span data-i18n="header.pilot">Acceso piloto</span></button>
    </div>
  </header>

  <main id="main">
    <section class="hero" id="top">
      <div class="hero__copy">
        <p class="kicker" data-i18n="hero.kicker">Exclusivo para estudios de tatuaje y artistas independientes</p>
        <h1><span class="hero-title-main" data-i18n="hero.title.main">Pon orden al caos de mensajes, citas y referencias.</span> <span data-i18n="hero.title.accent">Todo tu estudio en una sola Ficha de Trabajo.</span></h1>
        <p class="hero__lead" data-i18n="hero.lead">Inkendar convierte cada solicitud en una Ficha de Trabajo con el brief, las imágenes, el artista, la cita y la señal en un solo lugar. El piloto comienza con solicitudes web y captura en el estudio.</p>
        <div class="hero__actions">
          <button class="button button--accent" type="button" data-open-pilot data-plan="studio"><span data-i18n="hero.primary">Solicitar acceso piloto</span> <span aria-hidden="true">↗</span></button>
          <a class="button button--outline" href="#funciones"><span data-i18n="hero.secondary">Ver cómo funciona</span> <span aria-hidden="true">↓</span></a>
        </div>
        <div class="pilot-proof"><span aria-hidden="true">10</span><p><strong data-i18n="hero.proof.title">10 plazas en selección</strong><br /><span data-i18n="hero.proof.body">Beta privada · onboarding personal · aún sin autoservicio</span></p></div>
      </div>

      <div class="work-order-demo" aria-label="Vista previa ilustrativa de una ficha de trabajo" data-i18n-aria="demo.aria">
        <div class="demo-label"><span data-i18n="demo.preview">Vista previa</span><span data-i18n="demo.record">Ficha #128</span></div>
        <div class="source-stack" aria-hidden="true">
          <div class="source"><b>IG</b><small>Idea + foto</small></div><div class="source"><b>WA</b><small>Medidas</small></div><div class="source"><b>WEB</b><small>Disponibilidad</small></div>
        </div>
        <article class="work-order">
          <header><span><i></i> <span data-i18n="demo.status">En revisión</span></span><strong data-i18n="demo.day">MAR · 17:30</strong></header>
          <div class="client-row"><span class="avatar">LM</span><div><small data-i18n="demo.client">Cliente</small><strong>Lucía M.</strong></div><span class="tag">Instagram</span></div>
          <div class="work-grid"><div><small data-i18n="demo.placement">Zona</small><strong data-i18n="demo.placement.value">Antebrazo interior</strong></div><div><small data-i18n="demo.size">Tamaño</small><strong>12–15 cm</strong></div><div><small data-i18n="demo.style">Estilo</small><strong data-i18n="demo.style.value">Fine line botánico</strong></div><div><small data-i18n="demo.artist">Artista</small><strong>Ana R.</strong></div></div>
          <div class="references"><figure class="ref ref--one"><img src="/tattoo-reference-botanical.jpg" width="640" height="853" alt="Referencia fotográfica de un tatuaje botánico fine line" data-i18n-alt="demo.image.botanical.alt" decoding="async" /></figure><figure class="ref ref--two"><img src="/tattoo-reference-session.jpg" width="640" height="960" alt="Referencia fotográfica de una sesión de tatuaje en el brazo" data-i18n-alt="demo.image.session.alt" decoding="async" /></figure><div><small data-i18n="demo.references">Referencias reales</small><strong data-i18n="demo.references.count">2 imágenes vinculadas</strong><em data-i18n="demo.ready">Listas para la cita</em></div></div>
          <footer><span><i></i><span data-i18n="demo.deposit">Señal pendiente</span></span><span>Brief 8/8 ✓</span></footer>
        </article>
        <p data-i18n="demo.caption">Mensajes y formularios se convierten en contexto listo para trabajar.</p>
      </div>
    </section>

    <div class="trust-strip"><span data-i18n="trust.artist">Sin comisión por tatuaje</span><span data-i18n="trust.mobile">Móvil primero</span><span data-i18n="trust.setup">Datos separados por estudio</span><span data-i18n="trust.beta">Decisión artística humana</span></div>

    <section class="story section" id="recorrido" aria-labelledby="story-title">
      <header class="story__intro">
        <p data-i18n="story.eyebrow">Así funcionará Inkendar</p>
        <h2 id="story-title" data-i18n="story.title">El cliente escribe. El estudio recibe todo ordenado.</h2>
        <p class="story__lead" data-i18n="story.lead">El recorrido será muy sencillo: el cliente enviará su idea, Inkendar la llevará al panel del estudio y el equipo responderá desde allí.</p>
        <div class="story__channels" aria-label="Canales de entrada: web, Instagram y WhatsApp Business" data-i18n-aria="story.channels.aria"><span>WEB</span><span>INSTAGRAM</span><span>WHATSAPP</span></div>
        <p class="story__connected" data-i18n="story.connected">Así funcionará el producto final. Instagram y WhatsApp se conectarán cuando sus sistemas oficiales lo permitan.</p>
        <p class="story__format" data-i18n="story.format">Del mensaje a la cita · sin perder información</p>
        <ol class="story__index" aria-label="Capítulos del recorrido" data-i18n-aria="story.index.aria">
          <li><a href="#story-1"><span>01</span><em data-i18n="story.index.1">Mensaje</em></a></li>
          <li><a href="#story-2"><span>02</span><em data-i18n="story.index.2">Panel</em></a></li>
          <li><a href="#story-3"><span>03</span><em data-i18n="story.index.3">Cita</em></a></li>
          <li><a href="#story-4"><span>04</span><em data-i18n="story.index.4">Respuesta</em></a></li>
        </ol>
      </header>

      <div class="story__track">
        <article class="story-scene" id="story-1">
          <figure>
            <img src="/story/01-client-enquiry.webp" width="1080" height="1350" loading="lazy" decoding="async" alt="Cliente revisando una referencia botánica desde su teléfono antes de enviar una consulta" data-i18n-alt="story.scene1.alt" />
            <span class="story-scene__step" aria-hidden="true">01</span>
            <div class="story-scene__source" aria-hidden="true"><span data-i18n="story.scene1.web">WEB</span><span data-i18n="story.scene1.connected">WHATSAPP · INSTAGRAM</span></div>
            <figcaption data-i18n="story.scene1.subtitle">El cliente escribe desde WhatsApp, Instagram o la web.</figcaption>
          </figure>
          <div class="story-scene__copy">
            <p data-i18n="story.scene1.actor">Cliente</p>
            <h3 data-i18n="story.scene1.title">El cliente escribe como siempre.</h3>
            <p data-i18n="story.scene1.body">Podrá enviar su idea, sus fotos y sus datos por WhatsApp, Instagram o la web. El mensaje llegará al panel de Inkendar.</p>
            <strong data-i18n="story.scene1.result">El mensaje llega al estudio</strong>
          </div>
        </article>

        <article class="story-scene" id="story-2">
          <figure>
            <img src="/story/02-unified-job-sheet.webp" width="1080" height="1350" loading="lazy" decoding="async" alt="Responsable de estudio revisando una ficha de trabajo unificada en una tableta" data-i18n-alt="story.scene2.alt" />
            <span class="story-scene__step" aria-hidden="true">02</span>
            <div class="story-scene__source" aria-hidden="true"><span>INKENDAR</span><span class="story-scene__concept" data-i18n="story.concept">PRODUCTO FINAL</span></div>
            <figcaption data-i18n="story.scene2.subtitle">Inkendar convierte el mensaje en una ficha clara para el estudio.</figcaption>
          </figure>
          <div class="story-scene__copy">
            <p data-i18n="story.scene2.actor">Panel del estudio</p>
            <h3 data-i18n="story.scene2.title">Todo aparece en un solo lugar.</h3>
            <p data-i18n="story.scene2.body">Inkendar juntará el mensaje, las fotos, la zona del cuerpo y el tamaño en una sola ficha. Así el estudio no tendrá que buscar en varias aplicaciones.</p>
            <strong data-i18n="story.scene2.result">Todo queda ordenado</strong>
          </div>
        </article>

        <article class="story-scene" id="story-3">
          <figure>
            <img src="/story/03-artist-action.webp" width="1080" height="1350" loading="lazy" decoding="async" alt="Tatuador preparando la cita con la referencia y la ficha de trabajo" data-i18n-alt="story.scene3.alt" />
            <span class="story-scene__step" aria-hidden="true">03</span>
            <div class="story-scene__source" aria-hidden="true"><span data-i18n="story.scene3.badge">EL ESTUDIO DECIDE</span></div>
            <figcaption data-i18n="story.scene3.subtitle">El estudio revisa la idea, elige al artista y prepara la cita.</figcaption>
          </figure>
          <div class="story-scene__copy">
            <p data-i18n="story.scene3.actor">Equipo del estudio</p>
            <h3 data-i18n="story.scene3.title">El estudio prepara la cita.</h3>
            <p data-i18n="story.scene3.body">El equipo revisará la idea, elegirá al artista y preparará la cita. Inkendar organizará la información, pero el estudio tomará las decisiones.</p>
            <strong data-i18n="story.scene3.result">La cita queda preparada</strong>
          </div>
        </article>

        <article class="story-scene" id="story-4">
          <figure>
            <img src="/story/04-channel-response.webp" width="1080" height="1350" loading="lazy" decoding="async" alt="Responsable de estudio enviando una respuesta desde el panel al canal del cliente" data-i18n-alt="story.scene4.alt" />
            <span class="story-scene__step" aria-hidden="true">04</span>
            <div class="story-scene__source story-scene__source--phase"><span class="story-scene__concept" data-i18n="story.concept">PRODUCTO FINAL</span><span data-i18n="story.scene4.badge">RESPUESTA AL CLIENTE</span></div>
            <figcaption data-i18n="story.scene4.subtitle">La respuesta vuelve a WhatsApp, Instagram o la web.</figcaption>
          </figure>
          <div class="story-scene__copy">
            <p data-i18n="story.scene4.actor">Cliente</p>
            <h3 data-i18n="story.scene4.title">La respuesta vuelve al cliente.</h3>
            <p data-i18n="story.scene4.body">El estudio responderá desde Inkendar. El cliente recibirá el mensaje por el mismo canal que usó. Nada se enviará ni publicará sin que una persona lo decida.</p>
            <strong data-i18n="story.scene4.result">El cliente recibe una respuesta</strong>
          </div>
        </article>
      </div>
      <div class="story__controls" data-story-controls>
        <button type="button" data-story-prev aria-label="Escena anterior" data-i18n-aria="story.controls.prev" disabled>←</button>
        <p aria-live="polite"><span data-i18n="story.controls.scene">Escena</span> <strong data-story-current>1</strong> <span data-i18n="story.controls.of">de</span> 4</p>
        <button type="button" data-story-next aria-label="Escena siguiente" data-i18n-aria="story.controls.next">→</button>
      </div>
    </section>

    <section class="comparison section" id="comparador" data-comparison>
      <header class="section-heading">
        <p data-i18n="compare.eyebrow">El tiempo que hoy se escapa</p>
        <h2 data-i18n="compare.title">Tu trabajo no debería empezar buscando capturas.</h2>
        <div class="segmented"><button type="button" data-compare="chaos" aria-pressed="true" data-i18n="compare.tab.chaos">El caos diario</button><button type="button" data-compare="order" aria-pressed="false" data-i18n="compare.tab.order">Con Inkendar</button></div>
      </header>
      <div class="comparison-grid" data-state="chaos">
        <article class="compare-panel chaos">
          <div class="panel-tag"><span>×</span> <span data-i18n="compare.chaos.tag">El caos diario</span></div><h3 data-i18n="compare.chaos.title">El desorden te roba tiempo.</h3>
          <ul><li data-i18n="compare.chaos.item0">La idea llega por un canal, la referencia por otro y el tamaño termina apuntado en cualquier parte.</li><li data-i18n="compare.chaos.item1">Buscas la imagen correcta justo cuando deberías estar preparando el trabajo.</li><li data-i18n="compare.chaos.item2">Revisas citas y señales en varios sitios antes de saber qué está confirmado.</li><li data-i18n="compare.chaos.item3">Cuando el trabajo pasa a otro artista, parte del contexto puede perderse.</li></ul>
          <div class="chaos-scene" aria-hidden="true"><span>¿12 o 15 cm?</span><span>IMG_8241.jpg</span><span>SEÑAL ??</span></div>
        </article>
        <article class="compare-panel order">
          <div class="panel-tag"><span>✓</span> <span data-i18n="compare.order.tag">Con Inkendar</span></div><h3 data-i18n="compare.order.title">Una ficha, un siguiente paso.</h3>
          <dl><div><dt data-i18n="compare.order.term0">Solicitud ordenada</dt><dd data-i18n="compare.order.desc0">Las consultas web y presenciales siguen el mismo flujo. Instagram y WhatsApp se añadirán en la fase conectada.</dd></div><div><dt data-i18n="compare.order.term1">Referencias a mano</dt><dd data-i18n="compare.order.desc1">Brief, imágenes, zona, tamaño y artista permanecen juntos.</dd></div><div><dt data-i18n="compare.order.term2">Cita y señal claras</dt><dd data-i18n="compare.order.desc2">El estudio ve qué está pendiente y qué está confirmado sin mover dinero en el sistema.</dd></div><div><dt data-i18n="compare.order.term3">Vista “Hoy”</dt><dd data-i18n="compare.order.desc3">Cada artista abre el día con sus citas y la información necesaria.</dd></div></dl>
        </article>
      </div>
    </section>

    <section class="features section" id="funciones">
      <header class="section-heading section-heading--split"><div><p data-i18n="features.eyebrow">Lo que recuperas</p><h2 data-i18n="features.title">Una ficha para entender cada trabajo de un vistazo.</h2></div><p data-i18n="features.intro">El piloto empieza con solicitudes web y captura en el estudio. Los canales conectados se incorporarán después de validar sus integraciones oficiales.</p></header>
      <div class="feature-grid">
        {features.map(([icon, title, text, note], index) => <article class:list={['feature', index === 3 && 'feature--wide']}>
          <div class="feature__icon" aria-hidden="true">
            {icon === 'inbox' && <svg viewBox="0 0 32 32"><path d="M5 6h22v20H5zM5 18h6l2 3h6l2-3h6M10 11h12" /></svg>}
            {icon === 'file' && <svg viewBox="0 0 32 32"><path d="M8 4h12l5 5v19H8zM19 4v6h6M12 15h9M12 20h9" /></svg>}
            {icon === 'mobile' && <svg viewBox="0 0 32 32"><rect x="9" y="3" width="14" height="26" rx="2" /><path d="M13 7h6M14 25h4" /></svg>}
            {icon === 'today' && <svg viewBox="0 0 32 32"><rect x="5" y="7" width="22" height="20" rx="2" /><path d="M10 4v6M22 4v6M5 13h22M10 18h4M18 18h4M10 22h4" /></svg>}
          </div><span class="feature__index">0{index + 1}</span><h3 data-i18n={'features.' + icon + '.title'}>{title}</h3><p data-i18n={'features.' + icon + '.text'}>{text}</p>{note && <small data-i18n={'features.' + icon + '.note'}>{note}</small>}
        </article>)}
      </div>
      <div class="flow"><span data-i18n="flow.enquiry">Mensaje o formulario</span><i>→</i><span data-i18n="flow.sheet">Ficha de trabajo</span><i>→</i><span data-i18n="flow.appointment">Artista asignado</span><i>→</i><span data-i18n="flow.deposit">Cita preparada</span></div>
    </section>

    <section class="pricing section" id="precios" data-pricing>
      <header class="section-heading pricing-heading"><div><p data-i18n="pricing.eyebrow">Planes del piloto</p><h2 data-i18n="pricing.title">Cuéntanos cómo trabajas. Te ayudamos a elegir el plan adecuado.</h2></div><div class="segmented role"><button type="button" data-role="artist" aria-pressed="false" data-i18n="pricing.role.artist">Trabajo por mi cuenta</button><button type="button" data-role="studio" aria-pressed="true" data-i18n="pricing.role.studio">Somos un estudio</button></div></header>
      <div class="plan-grid">
        {plans.map((plan) => <article class:list={['plan', plan.recommended && 'plan--recommended']} data-plan-card={plan.id}>
          {plan.recommended && <div class="recommended" data-i18n="plans.recommended">Recomendado para el piloto</div>}
          <header><div><h3 data-i18n={'plans.' + plan.id + '.name'}>Plan {plan.label}</h3><p data-i18n={'plans.' + plan.id + '.audience'}>{plan.audience}</p></div><div class="plan-consult"><strong data-i18n="pricing.consult">Consultar</strong><span data-i18n="pricing.pending">Precio por confirmar</span></div></header>
          <ul>{plan.items.map((item, itemIndex) => <li><span>✓</span><span data-i18n={'plans.' + plan.id + '.item' + itemIndex}>{item}</span></li>)}</ul>
          <button class:list={['button', plan.recommended ? 'button--accent' : 'button--light']} type="button" data-open-pilot data-plan={plan.id}><span data-i18n={'plans.' + plan.id + '.cta'}>{plan.cta}</span> <span>↗</span></button>
        </article>)}
      </div>
      <p class="pricing-note" data-i18n="pricing.note">Todavía no hemos cerrado los precios. Cuéntanos cómo funciona tu estudio y te explicaremos el alcance del piloto sin compromiso.</p>
    </section>

    <section class="maker section"><div class="maker__mark" aria-hidden="true">IN<br />CA<br />NDI</div><div><p data-i18n="maker.eyebrow">Código a medida, no plantillas</p><h2 data-i18n="maker.title">Software creado cerca del problema.</h2></div><p><span data-i18n="maker.prefix">Inkendar es un producto de</span> <strong>Incandi</strong>, <span data-i18n="maker.suffix">desarrollado a medida por Marcos Álvarez, Full Stack Developer. Sin plantillas genéricas: software pensado para el trabajo real de un estudio de tatuaje.</span></p></section>

    <section class="closing section"><div><p data-i18n="closing.eyebrow">Fase piloto · selección abierta</p><h2 data-i18n="closing.title">Tu próximo tatuaje merece una ficha. Tu estudio también.</h2></div><button class="button button--light" type="button" data-open-pilot data-plan="studio"><span data-i18n="closing.cta">Solicitar una plaza</span> <span>↗</span></button></section>
  </main>

  <footer class="footer"><a class="brand brand--logo" href="#top" aria-label="Inkendar, volver arriba" data-i18n-aria="footer.home"><img src="/inkendar-logo.png" width="1774" height="887" alt="Inkendar" loading="lazy" /></a><p data-i18n="footer.beta">Beta privada · © 2026 Inkendar</p><a href="mailto:hola@inkendar.es">hola@inkendar.es</a></footer>

  <dialog class="pilot-dialog" data-pilot-dialog aria-labelledby="pilot-title">
    <div class="dialog-shell"><button class="dialog-close" type="button" data-close-dialog aria-label="Cerrar formulario" data-i18n-aria="modal.close">×</button>
      <div class="dialog-intro"><span class="dialog-stamp" data-i18n="modal.slots">10 plazas</span><p data-i18n="modal.eyebrow">Acceso temprano</p><h2 id="pilot-title" data-i18n="modal.title">Únete a la fase piloto exclusiva.</h2><p data-i18n="modal.description">Seleccionamos únicamente 10 estudios para refinar la versión final, con el objetivo de responder en menos de 24 horas laborables.</p><ul><li data-i18n="modal.bullet0">Onboarding personal</li><li data-i18n="modal.bullet1">Participación voluntaria</li><li data-i18n="modal.bullet2">Información del piloto sin compromiso</li></ul></div>
      <form class="pilot-form" data-pilot-form novalidate><input type="hidden" name="plan" value="studio" data-plan-input /><div class="selected-plan"><span data-i18n="modal.interest">Interés:</span> <strong data-plan-label>Plan Estudio</strong></div>
        <label><span data-i18n="modal.name">Nombre completo</span><input name="name" autocomplete="name" required placeholder="Artista o administrador" data-i18n-placeholder="modal.name.placeholder" aria-describedby="name-error" /><small id="name-error" data-i18n="modal.name.error">Escribe tu nombre para continuar.</small></label>
        <label><span data-i18n="modal.studio">Nombre del estudio</span><input name="studio" autocomplete="organization" required placeholder="Ej. Blackbird Tattoo" data-i18n-placeholder="modal.studio.placeholder" aria-describedby="studio-error" /><small id="studio-error" data-i18n="modal.studio.error">Indica el estudio o tu nombre profesional.</small></label>
        <label><span data-i18n="modal.email">Correo de contacto</span><input type="email" name="email" autocomplete="email" required placeholder="tu@estudio.com" data-i18n-placeholder="modal.email.placeholder" aria-describedby="email-error" /><small id="email-error" data-i18n="modal.email.error">Introduce un correo válido.</small></label>
        <label><span data-i18n="modal.instagram">Instagram del estudio</span><input name="instagram" required placeholder="@tuestudio" data-i18n-placeholder="modal.instagram.placeholder" pattern="^@?[A-Za-z0-9._]{2,30}$" aria-describedby="instagram-error" /><small id="instagram-error" data-i18n="modal.instagram.error">Usa el formato @tuestudio.</small></label>
        <div class="field-pair"><label><span data-i18n="modal.city">Ciudad</span><input name="city" autocomplete="address-level2" required placeholder="Tu ciudad" data-i18n-placeholder="modal.city.placeholder" aria-describedby="city-error" /><small id="city-error" data-i18n="modal.city.error">Indica tu ciudad.</small></label><label><span data-i18n="modal.artists">Número de artistas</span><input type="number" name="artists" min="1" max="50" required placeholder="Ej. 4" data-i18n-placeholder="modal.artists.placeholder" aria-describedby="artists-error" /><small id="artists-error" data-i18n="modal.artists.error">Indica cuántos artistas sois.</small></label></div>
        <label><span data-i18n="modal.channel">Canal principal actual</span><select name="channel" required aria-describedby="channel-error"><option value="" data-i18n="modal.channel.placeholder">Selecciona uno</option><option>Instagram</option><option>WhatsApp Business</option><option data-i18n="modal.channel.web">Formulario web</option><option data-i18n="modal.channel.inperson">Presencial / teléfono</option></select><small id="channel-error" data-i18n="modal.channel.error">Selecciona vuestro canal principal.</small></label>
        <label class="consent-row"><input type="checkbox" name="consent" required /><span data-i18n="modal.consent">Acepto que Inkendar use estos datos para responder a mi solicitud piloto.</span></label>
        <button class="button button--accent" type="submit"><span data-submit-label data-i18n="modal.submit">Enviar solicitud prioritaria</span><span>↗</span></button>
      </form>
      <div class="form-success" data-form-success role="status" aria-live="polite" hidden><span>✓</span><p data-i18n="modal.success">Solicitud registrada</p><h3 data-i18n="modal.success.title">Ya estás en la lista prioritaria.</h3><p data-i18n="modal.success.body">Esta demo no envía datos todavía. En la versión conectada recibirías confirmación por correo.</p><button class="button button--light" type="button" data-close-dialog data-i18n="modal.close">Cerrar</button></div>
    </div>
  </dialog>

  <script>
    import { translate } from '../scripts/landing-i18n';

    const dialog = document.querySelector('[data-pilot-dialog]');
    const form = document.querySelector('[data-pilot-form]');
    const success = document.querySelector('[data-form-success]');
    document.querySelectorAll('[data-open-pilot]').forEach(trigger => trigger.addEventListener('click', () => {
      if (!(dialog instanceof HTMLDialogElement)) return;
      const plan = trigger.getAttribute('data-plan') === 'artist' ? 'artist' : 'studio';
      const input = dialog.querySelector('[data-plan-input]'); const label = dialog.querySelector('[data-plan-label]');
      if (input instanceof HTMLInputElement) input.value = plan; if (label) label.textContent = plan === 'artist' ? translate('plans.artist.name', 'Plan Artista') : translate('plans.studio.name', 'Plan Estudio');
      form?.removeAttribute('hidden'); if (success instanceof HTMLElement) success.hidden = true; dialog.showModal();
    }));
    document.querySelectorAll('[data-close-dialog]').forEach(button => button.addEventListener('click', () => dialog instanceof HTMLDialogElement && dialog.close()));
    dialog?.addEventListener('click', event => { if (event.target === dialog && dialog instanceof HTMLDialogElement) dialog.close(); });
    form?.addEventListener('submit', event => {
      event.preventDefault(); if (!(form instanceof HTMLFormElement)) return; form.classList.add('was-validated'); form.querySelectorAll('[required]').forEach(field => field.setAttribute('aria-invalid', String((field instanceof HTMLInputElement || field instanceof HTMLSelectElement) && !field.checkValidity())));
      if (!form.checkValidity()) { const invalid = form.querySelector(':invalid'); if (invalid instanceof HTMLElement) invalid.focus(); return; }
      const button = form.querySelector('button[type="submit"]'); const label = form.querySelector('[data-submit-label]');
      if (button instanceof HTMLButtonElement) button.disabled = true; if (label) label.textContent = translate('modal.loading', 'Registrando…');
      window.setTimeout(() => { form.hidden = true; if (success instanceof HTMLElement) { success.hidden = false; success.querySelector('button')?.focus(); } form.reset(); form.classList.remove('was-validated'); form.querySelectorAll('[aria-invalid]').forEach(field => field.removeAttribute('aria-invalid')); if (button instanceof HTMLButtonElement) button.disabled = false; if (label) label.textContent = translate('modal.submit', 'Enviar solicitud prioritaria'); }, 650);
    });
    document.addEventListener('inkendar:languagechange', () => {
      const input = dialog?.querySelector('[data-plan-input]'); const planLabel = dialog?.querySelector('[data-plan-label]'); const submitLabel = form?.querySelector('[data-submit-label]');
      if (input instanceof HTMLInputElement && planLabel) planLabel.textContent = input.value === 'artist' ? translate('plans.artist.name', 'Plan Artista') : translate('plans.studio.name', 'Plan Estudio');
      const submitButton = form?.querySelector('button[type="submit"]');
      if (submitLabel) submitLabel.textContent = submitButton instanceof HTMLButtonElement && submitButton.disabled ? translate('modal.loading', 'Registrando…') : translate('modal.submit', 'Enviar solicitud prioritaria');
    });
    const initialPlanLabel = dialog?.querySelector('[data-plan-label]');
    if (initialPlanLabel) initialPlanLabel.textContent = translate('plans.studio.name', 'Plan Estudio');
    const storyTrack = document.querySelector<HTMLElement>('.story__track');
    const storyScenes = [...document.querySelectorAll<HTMLElement>('.story-scene')];
    const storyCurrent = document.querySelector<HTMLElement>('[data-story-current]');
    const storyPrevious = document.querySelector<HTMLButtonElement>('[data-story-prev]');
    const storyNext = document.querySelector<HTMLButtonElement>('[data-story-next]');
    let activeStoryIndex = 0;
    let storyScrollFrame = 0;
    const updateStoryControls = (index: number, shouldScroll = false) => {
      activeStoryIndex = Math.max(0, Math.min(index, storyScenes.length - 1));
      if (storyCurrent) storyCurrent.textContent = String(activeStoryIndex + 1);
      if (storyPrevious) storyPrevious.disabled = activeStoryIndex === 0;
      if (storyNext) storyNext.disabled = activeStoryIndex === storyScenes.length - 1;
      if (shouldScroll && storyTrack) {
        const trackBox = storyTrack.getBoundingClientRect();
        const sceneBox = storyScenes[activeStoryIndex]?.getBoundingClientRect();
        if (sceneBox) storyTrack.scrollTo({ left: storyTrack.scrollLeft + sceneBox.left - trackBox.left - 16, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      }
    };
    storyPrevious?.addEventListener('click', () => updateStoryControls(activeStoryIndex - 1, true));
    storyNext?.addEventListener('click', () => updateStoryControls(activeStoryIndex + 1, true));
    storyTrack?.addEventListener('scroll', () => {
      cancelAnimationFrame(storyScrollFrame);
      storyScrollFrame = requestAnimationFrame(() => {
        const trackBox = storyTrack.getBoundingClientRect();
        const trackCenter = trackBox.left + trackBox.width / 2;
        const nearest = storyScenes.reduce((best, scene, index) => Math.abs(scene.getBoundingClientRect().left + scene.offsetWidth / 2 - trackCenter) < best.distance ? { index, distance: Math.abs(scene.getBoundingClientRect().left + scene.offsetWidth / 2 - trackCenter) } : best, { index: 0, distance: Number.POSITIVE_INFINITY });
        updateStoryControls(nearest.index);
      });
    }, { passive: true });
    updateStoryControls(0);
    const comparison = document.querySelector('[data-comparison]');
    form?.querySelectorAll('input, select').forEach(field => field.addEventListener('input', () => field.removeAttribute('aria-invalid')));
    comparison?.querySelectorAll('[data-compare]').forEach(button => button.addEventListener('click', () => { const state = button.getAttribute('data-compare') || 'chaos'; comparison.querySelector('.comparison-grid')?.setAttribute('data-state', state); comparison.querySelectorAll('[data-compare]').forEach(item => item.setAttribute('aria-pressed', String(item === button))); }));
    const pricing = document.querySelector('[data-pricing]');
    pricing?.querySelectorAll('[data-role]').forEach(button => button.addEventListener('click', () => { const role = button.getAttribute('data-role'); pricing.querySelectorAll('[data-role]').forEach(item => item.setAttribute('aria-pressed', String(item === button))); pricing.querySelectorAll('[data-plan-card]').forEach(card => card.classList.toggle('is-selected', card.getAttribute('data-plan-card') === role)); }));
    const demo = document.querySelector('.work-order-demo'); if (demo) new IntersectionObserver(([entry]) => entry?.isIntersecting && entry.target.classList.add('is-assembled'), { threshold: .3 }).observe(demo);
  </script>
</body>
</html>
